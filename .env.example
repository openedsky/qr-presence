# -----------------------------------------------------------------------------
# SODEFOR Présences — variables d'environnement
# Copier ce fichier vers .env puis adapter les valeurs.
# En production Dokploy, déclarer les mêmes clés dans l'interface.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=production
APP_NAME="SODEFOR Présences"
APP_URL=https://presence.sodefor.ci
NEXT_PUBLIC_APP_URL=https://presence.sodefor.ci
NEXT_PUBLIC_ORG_NAME=SODEFOR
NEXT_PUBLIC_MINISTRY_NAME="Ministère des Eaux et Forêts"

# Auth.js — générer avec: openssl rand -base64 32
AUTH_SECRET=change-me-with-a-long-random-secret
AUTH_URL=https://presence.sodefor.ci
AUTH_TRUST_HOST=true

# Base MariaDB / MySQL
# Local XAMPP: mysql://root:@localhost:3306/sodefor_presences
# Docker:      mysql://sodefor:sodefor@mariadb:3306/sodefor_presences
DATABASE_URL="mysql://sodefor:sodefor@mariadb:3306/sodefor_presences"

# Redis (rate limiting, QR dynamique, compteurs, sessions)
REDIS_URL=redis://redis:6379

# Stockage signatures et PDF
# local = disque (développement) | s3 = stockage compatible S3 (SeaweedFS, AWS S3, MinIO…)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=sodefor-presences
S3_ACCESS_KEY=sodefor
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=/data/storage

# Seed au premier démarrage Docker (1 = oui)
SEED_ON_BOOT=1

# SSO / OIDC (optionnel — laisser vide pour l'auth interne)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Ancienne base à migrer (optionnel)
LEGACY_DATABASE_URL=

# Rate limiting
RATE_LIMIT_PER_MINUTE=20
DYNAMIC_QR_SECONDS=45
