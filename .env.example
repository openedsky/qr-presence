# -----------------------------------------------------------------------------
# SODEFOR Présences — variables d'environnement
# Copier ce fichier vers .env puis adapter les valeurs.
# En production Dokploy, déclarer les mêmes clés dans l'interface.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=production
APP_NAME="SODEFOR Présences"
APP_URL=https://presence.sodefor.ci
NEXT_PUBLIC_APP_URL=https://presence.sodefor.ci
NEXT_PUBLIC_ORG_NAME=SODEFOR
NEXT_PUBLIC_MINISTRY_NAME="Ministère des Eaux et Forêts"

# Auth.js — générer avec: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://presence.sodefor.ci
AUTH_TRUST_HOST=true

# Base MariaDB / MySQL
# Local XAMPP: mysql://root:@localhost:3306/sodefor_presences
# Docker:      mysql://sodefor:sodefor@mariadb:3306/sodefor_presences
DATABASE_URL="mysql://sodefor:sodefor@mariadb:3306/sodefor_presences?connection_limit=10&pool_timeout=10"

# Redis (rate limiting, QR dynamique, compteurs, sessions)
REDIS_URL=redis://redis:6379

# Stockage signatures et PDF
# local = disque (développement) | s3 = stockage compatible S3 (SeaweedFS, AWS S3, MinIO…)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=sodefor-presences
S3_ACCESS_KEY=sodefor
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=/data/storage

# Initialisation idempotente au démarrage Docker : premier super administrateur (s'il n'en existe aucun) et référentiel
# auto = base neuve ou nouvelle migration seulement ; 1 = à chaque démarrage ; 0 = jamais
SEED_ON_BOOT=auto
INITIAL_ADMIN_EMAIL=admin@sodefor.ci
# Vide = mot de passe provisoire aléatoire écrit dans <STORAGE_LOCAL_DIR>/.secrets/admin-temporary-password.txt ;
# dans tous les cas à changer à la première connexion (expire après 7 jours)
INITIAL_ADMIN_PASSWORD=
# Environnements de test uniquement : comptes et réunion de démonstration (mot de passe DEMO_PASSWORD ou aléatoire)
SEED_DEMO=0
DEMO_PASSWORD=

# Nombre de proxys de confiance devant l'application (lecture de l'IP réelle) ; 0 en accès direct
TRUSTED_PROXY_HOPS=1
INTERNAL_EMAIL_DOMAINS=sodefor.ci
# Détail de /api/health?details=1 (en-tête Authorization: Bearer <jeton>)
HEALTH_TOKEN=
# Désactive les tâches planifiées (clôture automatique, purge) : tests uniquement
DISABLE_JOBS=0

# SSO / OIDC (optionnel — laisser vide pour l'auth interne)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Ancienne base à migrer (optionnel)
LEGACY_DATABASE_URL=

# Rate limiting
RATE_LIMIT_PER_MINUTE=20
DYNAMIC_QR_SECONDS=45
