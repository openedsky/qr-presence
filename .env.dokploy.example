# Variables à coller dans Dokploy > Compose > Environment (avec docker-compose.dokploy.yml).
# Générer chaque secret avec : openssl rand -hex 32   (hexadécimal : sans caractère à échapper dans les URL)

APP_URL=https://presence.sodefor.ci
AUTH_SECRET=
# L'application est derrière Traefik (Dokploy), qui fixe l'en-tête Host : laisser à true.
AUTH_TRUST_HOST=true

DB_NAME=sodefor_presences
DB_USER=sodefor
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_PASSWORD=

# Stockage objet des signatures et PDF (service "storage" SeaweedFS par défaut)
S3_ACCESS_KEY=sodefor
S3_SECRET_KEY=
S3_BUCKET=sodefor-presences
# Pour un S3 externe : S3_ENDPOINT=https://s3.exemple.ci  (et S3_REGION si nécessaire)

# Nombre de proxys devant l'application (Traefik de Dokploy = 1) : sert à lire l'IP réelle du participant
TRUSTED_PROXY_HOPS=1
# Domaines email considérés comme internes pour les réunions fermées aux invités externes
INTERNAL_EMAIL_DOMAINS=sodefor.ci

# Premier super administrateur, créé au premier démarrage s'il n'en existe aucun.
# Sans mot de passe, un mot de passe provisoire est écrit dans /data/storage/.secrets/admin-temporary-password.txt.
# Dans tous les cas, il doit être changé à la première connexion.
INITIAL_ADMIN_EMAIL=admin@sodefor.ci
INITIAL_ADMIN_PASSWORD=

# Initialisation idempotente (premier administrateur, référentiel) : auto = base neuve ou nouvelle migration.
SEED_ON_BOOT=auto
# Ne jamais activer en production : crée des comptes et une réunion de démonstration.
# SEED_DEMO=1

# Jeton facultatif pour le détail de /api/health?details=1 (en-tête Authorization: Bearer <jeton>)
HEALTH_TOKEN=

# Rotation des sauvegardes quotidiennes de la base et des fichiers (jours)
BACKUP_RETENTION_DAYS=14
# Phrase de chiffrement des sauvegardes (openssl rand -base64 32) : à conserver hors du serveur
BACKUP_PASSPHRASE=
# Copie hors site de chaque archive ({} = chemin), ex. rclone copy {} distant:sodefor-backups
BACKUP_REMOTE_CMD=

# Ne passer à 1 que ponctuellement, pour une évolution de schéma destructive validée
PRISMA_ACCEPT_DATA_LOSS=0
