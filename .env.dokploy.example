# Variables à coller dans Dokploy > Compose > Environment
# (avec docker-compose.dokploy.yml). Générer chaque secret avec : openssl rand -base64 32

APP_URL=https://presence.sodefor.ci
AUTH_SECRET=

DB_NAME=sodefor_presences
DB_USER=sodefor
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Stockage objet des signatures et PDF (service "storage" SeaweedFS par défaut)
S3_ACCESS_KEY=sodefor
S3_SECRET_KEY=
S3_BUCKET=sodefor-presences
# Pour un S3 externe : S3_ENDPOINT=https://s3.exemple.ci  (et S3_REGION si nécessaire)

# 1 au tout premier déploiement pour créer les comptes de démonstration, puis 0
SEED_ON_BOOT=1
# Ne passer à 1 que ponctuellement, pour une évolution de schéma destructive validée
PRISMA_ACCEPT_DATA_LOSS=0
